[Unit]
Description=Allocate subordinate IDs for Incus
Before=incus.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'grep -q "^root:" /etc/subuid || usermod --add-subuids 1000000-1000999999 root'
ExecStart=/bin/sh -c 'grep -q "^root:" /etc/subgid || usermod --add-subgids 1000000-1000999999 root'

[Install]
RequiredBy=incus.service
