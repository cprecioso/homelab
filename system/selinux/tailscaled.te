policy_module(tailscaled, 1.0.0)

########################################
#
# Declarations
#

type tailscaled_t;
type tailscaled_exec_t;
init_daemon_domain(tailscaled_t, tailscaled_exec_t)

########################################
#
# Local policy
#

# Without a policy of its own tailscaled falls back to the catch-all
# unconfined_service_t domain, so keep it just as unrestricted as that.
unconfined_domain(tailscaled_t)

# Tailscale SSH is served by tailscaled itself instead of sshd, so tailscaled
# needs the privileges of a login program to set up the user session.
auth_login_pgm_domain(tailscaled_t)
unconfined_shell_domtrans(tailscaled_t)
userdom_spec_domtrans_all_users(tailscaled_t)
